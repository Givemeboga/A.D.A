models/
*.onnx
*.tflite
*.gguf
*.bin
*.safetensors
*.pt

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.python-version.local
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- editors and OS ----
.vscode/*
